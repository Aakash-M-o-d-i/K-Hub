# Knowledge Hub - Environment Configuration Template
# Copy this file to .env and fill in your local values

# Flask Security (Generate complex strings for production)
SECRET_KEY=your-development-secret-key
JWT_SECRET_KEY=your-development-jwt-secret

# Database Configuration (MySQL)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pyq_db

# Email Configuration (Brevo)
# Obtain an API key from https://www.brevo.com/
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@knowledgehub.com
BREVO_SENDER_NAME=Knowledge Hub
